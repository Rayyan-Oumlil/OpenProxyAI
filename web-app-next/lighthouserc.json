{
  "ci": {
    "collect": {
      "staticDistDir": "build/client",
      "url": [
        "http://localhost/",
        "http://localhost/models/",
        "http://localhost/agents/",
        "http://localhost/trust/",
        "http://localhost/finops/",
        "http://localhost/engineering/",
        "http://localhost/pricing/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2000
          }
        ],
        "total-byte-weight": [
          "warn",
          {
            "maxNumericValue": 600000
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 204800
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
