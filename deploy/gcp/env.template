# =============================================================================
# OpenProxyAI — Production Environment Variables
# Add ALL of these as GitHub repository secrets (Settings → Secrets → Actions)
# =============================================================================

# ── GCP Infrastructure (set by setup.sh output) ──────────────────────────────
# Auth: Workload Identity Federation (no JSON key needed). See setup.sh.
GCP_REGION=northamerica-northeast1
GCP_AR_IMAGE=northamerica-northeast1-docker.pkg.dev/PROJECT_ID/openproxyai/backend
GCP_CLOUD_RUN_SERVICE=openproxyai-backend
GCP_DB_CONNECTION_NAME=PROJECT_ID:northamerica-northeast1:openproxyai-db
GCP_VPC_CONNECTOR=projects/PROJECT_ID/locations/northamerica-northeast1/connectors/openproxyai-connector
GCP_WORKLOAD_IDENTITY_PROVIDER=projects/PROJECT_NUMBER/locations/global/workloadIdentityPools/github-actions-pool/providers/github
GCP_SERVICE_ACCOUNT=github-actions@PROJECT_ID.iam.gserviceaccount.com
GCP_RUNTIME_SERVICE_ACCOUNT=openproxyai-run@PROJECT_ID.iam.gserviceaccount.com

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://openproxyai:YOUR_DB_PASSWORD@/openproxyai?host=/cloudsql/CONNECTION_NAME
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:YOUR_POSTGRES_PASSWORD@/openproxyai?host=/cloudsql/CONNECTION_NAME

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://REDIS_HOST:6379/0

# ── App ───────────────────────────────────────────────────────────────────────
SECRET_KEY=<min 32 chars, generate with: openssl rand -hex 32>
APP_ENV=production
DEBUG=false

# ── CORS (your frontend URLs) ─────────────────────────────────────────────────
# Comma-separated or JSON array. Use explicit origins in production.
# If set to "*", credentials (cookies) are disabled — prefer explicit URLs.
CORS_ORIGINS=https://your-app.vercel.app,https://app.openproxy.ai

# ── SSO (required for OIDC) ──────────────────────────────────────────────────
# Public API base URL — used to validate OIDC redirect_uri (e.g. https://api.openproxy.ai)
APP_BASE_URL=https://api.openproxy.ai
# Frontend base URL for SSO redirect after auth (e.g. https://app.openproxy.ai); defaults to first CORS origin
# FRONTEND_BASE_URL=https://app.openproxy.ai

# ── Security ─────────────────────────────────────────────────────────────────
# Set true only when behind a trusted reverse proxy that overwrites X-Forwarded-For
TRUSTED_PROXY=false

# ── Stripe (fill when ready — leave empty to disable billing) ─────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_GROWTH_PRICE_ID=price_...
STRIPE_METERED_PRICE_ID=price_...
STRIPE_METERED_BASE_PRICE_ID=price_...
STRIPE_SUCCESS_URL=https://app.openproxy.ai/billing?success=1
STRIPE_CANCEL_URL=https://app.openproxy.ai/billing?canceled=1

# ── LLM Provider Keys (optional — orgs add their own via dashboard) ───────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── Observability (all optional) ─────────────────────────────────────────────
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
PROMETHEUS_ENABLED=true
CLICKHOUSE_URL=

# ── Cache (enable in production) ─────────────────────────────────────────────
CACHE_ENABLED=true
SEMANTIC_CACHE_ENABLED=true

# ── Batched spend writes (optional — reduces DB write load at scale) ─────────
# BATCH_SPEND_ENABLED=false
# BATCH_SPEND_FLUSH_INTERVAL_SECONDS=60
# BATCH_SPEND_MAX_SIZE=500

# ── Spend reports (weekly Monday 9am UTC, monthly 1st 9am UTC) ─────────────────
# Orgs opt-in via settings: {"spend_report": {"webhook": "https://hooks.slack.com/...", "email": "admin@org.com"}}
# SENDGRID_API_KEY=SG....
# EMAIL_FROM=noreply@openproxyai.com

# ── Provider health check (optional — pings keys every 5 min) ──────────────────
# PROVIDER_HEALTH_CHECK_ENABLED=false
# PROVIDER_HEALTH_FAILURE_THRESHOLD=3

# ── Circuit breaker (optional — skip keys after N consecutive 429/5xx) ─────────
# CIRCUIT_BREAKER_ENABLED=false
# CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# CIRCUIT_BREAKER_COOLDOWN_SECONDS=60

# ── Key rotation scheduler (optional — re-encrypt keys every N days) ───────────
# KEY_ROTATION_SCHEDULER_ENABLED=false
# KEY_ROTATION_INTERVAL_DAYS=30

# ── Experiment eval hook (optional — auto-submit quality scores) ─────────────────
# EVAL_HOOK_URL=https://your-eval-service/score  # POST {prompt,response,request_id}; expect {scores:[{name,value}]}
# EVAL_LLM_MODEL=openai/gpt-4o                  # LLM-as-judge; uses litellm env keys

# ── Router strategy: simple_shuffle | round_robin | lowest_latency ─────────────
# ROUTER_STRATEGY=simple_shuffle

# ── Adaptive load balancing (optional — penalize high latency/error keys) ──────
# Samples request_logs every N minutes; adjusts effective weights for key selection
# ADAPTIVE_LB_ENABLED=false
# ADAPTIVE_LB_SAMPLE_MINUTES=10
# ADAPTIVE_LB_WEIGHT_FLOOR=0.1
