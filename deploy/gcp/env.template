# =============================================================================
# OpenProxyAI — Production Environment Variables
# Add ALL of these as GitHub repository secrets (Settings → Secrets → Actions)
# =============================================================================

# ── GCP Infrastructure (set by setup.sh output) ──────────────────────────────
# Auth: Workload Identity Federation (no JSON key needed). See setup.sh.
GCP_REGION=northamerica-northeast1
GCP_AR_IMAGE=northamerica-northeast1-docker.pkg.dev/PROJECT_ID/openproxyai/backend
GCP_CLOUD_RUN_SERVICE=openproxyai-backend
GCP_DB_CONNECTION_NAME=PROJECT_ID:northamerica-northeast1:openproxyai-db
GCP_VPC_CONNECTOR=projects/PROJECT_ID/locations/northamerica-northeast1/connectors/openproxyai-connector
GCP_WORKLOAD_IDENTITY_PROVIDER=projects/PROJECT_NUMBER/locations/global/workloadIdentityPools/github-actions-pool/providers/github
GCP_SERVICE_ACCOUNT=github-actions@PROJECT_ID.iam.gserviceaccount.com
GCP_RUNTIME_SERVICE_ACCOUNT=openproxyai-run@PROJECT_ID.iam.gserviceaccount.com

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://openproxyai:YOUR_DB_PASSWORD@/openproxyai?host=/cloudsql/CONNECTION_NAME
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:YOUR_POSTGRES_PASSWORD@/openproxyai?host=/cloudsql/CONNECTION_NAME

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://REDIS_HOST:6379/0

# ── App ───────────────────────────────────────────────────────────────────────
SECRET_KEY=<min 32 chars, generate with: openssl rand -hex 32>
APP_ENV=production
DEBUG=false

# ── CORS (your frontend URLs) ─────────────────────────────────────────────────
# Add your Vercel URL and custom domain when you have one
CORS_ORIGINS=["https://your-app.vercel.app","https://app.openproxy.ai"]

# ── Stripe (fill when ready — leave empty to disable billing) ─────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_GROWTH_PRICE_ID=price_...
STRIPE_METERED_PRICE_ID=price_...
STRIPE_METERED_BASE_PRICE_ID=price_...
STRIPE_SUCCESS_URL=https://app.openproxy.ai/billing?success=1
STRIPE_CANCEL_URL=https://app.openproxy.ai/billing?canceled=1

# ── LLM Provider Keys (optional — orgs add their own via dashboard) ───────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── Observability (all optional) ─────────────────────────────────────────────
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
PROMETHEUS_ENABLED=true
CLICKHOUSE_URL=

# ── Cache (enable in production) ─────────────────────────────────────────────
CACHE_ENABLED=true
SEMANTIC_CACHE_ENABLED=true
